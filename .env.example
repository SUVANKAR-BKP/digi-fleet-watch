# ---- FleetWatch configuration (copy to .env) ----

# Password for the dedicated Postgres user (used by the db container).
POSTGRES_PASSWORD=change-me-strong-password

# Local dev URL. docker-compose overrides the host to "db" at runtime.
DATABASE_URL=postgres://fleetwatch:change-me-strong-password@localhost:5432/fleetwatch

# Shared secret agents use to authenticate to POST /api/ingest.
# Generate with: openssl rand -hex 32
AGENT_API_TOKEN=change-me-long-random-token

# Optional Slack incoming webhook for downtime alerts. Empty = disabled.
SLACK_WEBHOOK_URL=

# Public base URL, shown in agent install instructions.
FLEETWATCH_PUBLIC_URL=https://fleet.example.com
