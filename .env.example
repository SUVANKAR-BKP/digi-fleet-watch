# ---- Digi Fleet Watch configuration (copy to .env) ----

# Password for the dedicated Postgres user (used by the db container).
POSTGRES_PASSWORD=change-me-strong-password

# Local dev URL. docker-compose overrides the host to "db" at runtime.
DATABASE_URL=postgres://fleetwatch:change-me-strong-password@localhost:5432/fleetwatch

# Shared secret agents use to authenticate to POST /api/ingest.
# Generate a real one with: openssl rand -hex 32
AGENT_API_TOKEN=

# Rotation grace token. While set, agents presenting this value are still
# accepted (and logged by hostname) so a fleet can be moved to a new secret
# one host at a time instead of all 401ing at once. Managed for you by
# ./scripts/rotate-agent-token.sh — leave it empty in normal operation.
AGENT_API_TOKEN_PREVIOUS=

# ---- Dashboard accounts ----
# The dashboard requires a signed-in user. On a fresh instance with no accounts,
# open the app and it redirects to /setup to create the first admin.
#
# To create that admin non-interactively instead (automated deploys), set both
# of these. They are ignored once any account exists.
FLEETWATCH_ADMIN_USER=
FLEETWATCH_ADMIN_PASSWORD=

# Legacy: the old single shared password. If set on an instance with no
# accounts, it is upgraded into an "admin" user with this password so an
# existing deployment is not locked out. Remove it once you have signed in.
FLEETWATCH_DASHBOARD_PASSWORD=

# Key used to sign session cookies. Changing it signs everyone out.
# Generate with: openssl rand -hex 32
# If empty, AGENT_API_TOKEN is used instead — which means rotating that token
# also signs everyone out. Setting this explicitly is recommended.
FLEETWATCH_SESSION_SECRET=

# Optional Slack incoming webhook for downtime alerts. Empty = disabled.
SLACK_WEBHOOK_URL=

# Public base URL used in generated "Add Host" install commands + email links.
# Set this when the instance is behind a domain / Cloudflare; otherwise the
# command is derived automatically from the request's Host header.
# Leave empty to auto-derive from the request.
PUBLIC_FLEETWATCH_URL=

# Legacy alias (optional) — kept for older deployments.
FLEETWATCH_PUBLIC_URL=

# ---- Email alerts (optional) ----
# When set, Digi Fleet Watch emails about downtime, new package updates and
# deprecated Docker engines. Leave SMTP_HOST empty to disable.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false            # true for implicit TLS (port 465)
SMTP_USER=alerts@example.com
SMTP_PASS=change-me
MAIL_FROM="Digi Fleet Watch <alerts@example.com>"
ALERT_EMAIL_TO=ops@example.com