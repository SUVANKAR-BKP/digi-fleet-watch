# Digi Fleet Watch standalone containerized agent.
#
# For hosts that can't run the bare-metal install (no systemd AND no cron —
# minimal/container-only environments). It talks to Docker through a mounted
# socket, so it can see sibling containers on the same Docker host, but it
# CANNOT see host-level apt/dpkg package data (no host filesystem).
#
# Build from the repo root so the agent script is in the build context:
#   docker build -f agent/Dockerfile.agent -t digi-fleet-watch-agent:latest .
#
# Run (must pass FLEETWATCH_URL + AGENT_API_TOKEN + the Docker socket):
#   docker run -d --name fleetwatch-agent \
#     -e FLEETWATCH_URL=http://<YOUR_SERVER_HOST>:3000 \
#     -e AGENT_API_TOKEN=<token> \
#     -v /var/run/docker.sock:/var/run/docker.sock:ro \
#     --restart unless-stopped \
#     digi-fleet-watch-agent:latest

FROM alpine:3.20

# bash for the agent script, curl + jq to report, docker-cli to talk to the
# socket-mounted daemon.
RUN apk add --no-cache bash curl jq docker-cli

COPY agent.sh /opt/digi-fleet-watch/agent.sh
RUN chmod 0755 /opt/digi-fleet-watch/agent.sh

# Containers have no systemd/cron and don't need them — run the collect loop.
ENTRYPOINT ["/bin/sh", "-c", "\
set -e; \
while true; do \
  /opt/digi-fleet-watch/agent.sh || true; \
  sleep 300; \
done"]
