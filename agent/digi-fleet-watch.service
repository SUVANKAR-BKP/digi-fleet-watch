[Unit]
Description=Digi Fleet Watch agent — collect and report host state
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fleetwatch
Group=fleetwatch
EnvironmentFile=-/etc/digi-fleet-watch/agent.env
ExecStart=/bin/bash /opt/digi-fleet-watch/agent.sh

# Restart the unit if it crashes; systemd timers still respect the schedule.
Restart=on-failure
RestartSec=30s