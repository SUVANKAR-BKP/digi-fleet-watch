[Unit]
Description=FleetWatch agent — collect and report host state
Documentation=https://github.com/your-org/fleetwatch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=fleetwatch
Group=fleetwatch
EnvironmentFile=-/etc/fleetwatch/agent.env
ExecStart=/bin/bash /opt/fleetwatch/agent.sh

# Restart the unit if it crashes; systemd timers still respect the schedule.
Restart=on-failure
RestartSec=30s